{
  "name": "Chinese Characters to Pinyin Initial Letters (Jieba Segmentation)",
  "normalization": [
    { "dict": { "type": "ocd2", "file": "CJK_Compatibility_Ideographs.ocd2" } }
  ],
  "segmentation": {
    "type": "jieba",
    "resources": {
      "dict_path": "jieba_dict/jieba_merged.ocd2",
      "model_path": "jieba_dict/hmm_model.utf8"
    }
  },
  "conversion_chain": [
    {
      "dict": {
        "type": "group",
        "match_policy": "short_circuit",
        "dicts": [
          { "type": "ocd2", "file": "phrase_init_letter.ocd2" },
          { "type": "ocd2", "file": "pinyin_init_letter.ocd2" }
        ]
      }
    }
  ]
}